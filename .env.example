APP_NAME="Sandy-Trading-AI"
ENV=local

TRADING_MODE=SHADOW_LIVE_REAL_DATA
LIVE_TRADING_ENABLED=false
KILL_SWITCH=true

DATABASE_URL=postgresql+psycopg://dalalwall:dalalwall@localhost:5432/dalalwall_ai_alpha
REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=

ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ZERODHA_AUTO_EXCHANGE_ON_CALLBACK=true

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex

ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
BENZINGA_API_KEY=

BASE_CURRENCY=INR
STARTING_CAPITAL_INR=500000

REAL_PROVIDER_REQUIRED=true
BROKER_RECONCILIATION_REQUIRED=true
RISK_ENGINE_REQUIRED=true

ALLOW_DUMMY_BROKER=false
ALLOW_MOCK_BROKER=false
ALLOW_FAKE_MARKET_DATA=false
ALLOW_FAKE_ORDER_FILLS=false

LONG_ONLY_MODE=true
ALLOW_MARGIN=false
ALLOW_SHORT_SELLING=false
ALLOW_OPTIONS=false
ALLOW_DERIVATIVES=false
ALLOW_CRYPTO=false
ALLOW_LEVERAGED_ETFS=false

MAX_RISK_PER_TRADE_PCT=0.005
MAX_DAILY_LOSS_PCT=0.0125
MAX_WEEKLY_LOSS_PCT=0.04
MAX_MONTHLY_DRAWDOWN_PCT=0.08
MAX_TOTAL_DRAWDOWN_PCT=0.10

MAX_SINGLE_STOCK_POSITION_PCT=0.075
MAX_SINGLE_ETF_POSITION_PCT=0.15
MAX_GOLD_ETF_POSITION_PCT=0.20
MAX_DEBT_ETF_POSITION_PCT=0.30
MAX_SECTOR_EXPOSURE_PCT=0.25
MAX_TOTAL_EQUITY_EXPOSURE_PCT=0.80
MAX_INDIA_EXPOSURE_PCT=0.70
MAX_US_EXPOSURE_PCT=0.70

MAX_OPEN_POSITIONS_TOTAL=15
MAX_OPEN_POSITIONS_INDIA=8
MAX_OPEN_POSITIONS_US=8

DATA_STALENESS_SECONDS_INTRADAY=120
NEWS_STALENESS_MINUTES=60
FX_STALENESS_MINUTES=60

INDIA_TIMEZONE=Asia/Kolkata
US_TIMEZONE=America/New_York

INDIA_ALGO_COMPLIANCE_REQUIRED=true
INDIA_ALGO_REGISTRATION_STATUS=NOT_APPROVED
INDIA_BROKER_APPROVAL_STATUS=NOT_APPROVED
INDIA_EXCHANGE_ALGO_IDENTIFIER=

ENABLE_EMAIL_SUMMARY=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_REQUIRE_AUTH=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=

SHADOW_TRAINING_ENABLED=true
SHADOW_TRAINING_INTERVAL_SECONDS=60
SHADOW_HYPOTHESIS_NOTIONAL_INR=50000
INTRADAY_MIN_TOTAL_SAMPLES=100000
INTRADAY_MIN_SAMPLES_PER_MARKET=25000
INTRADAY_MIN_STOP_LOSS_COVERAGE=0.98
INTRADAY_TRAINING_MAX_SAMPLES=150000
INTRADAY_EXIT_PROFIT_LOCK_PCT=0.70
INTRADAY_EXIT_LOSS_WATCH_PCT=0.50
INTRADAY_PROFIT_GIVEBACK_EXIT_PCT=0.25
INTRADAY_MIN_PROFIT_LOCK_INR=300
INTRADAY_MIN_PROFIT_LOCK_PCT=0.005
INTRADAY_PROFIT_BOOKING_ENABLED=true
INTRADAY_PROFIT_BOOKING_TARGET_PROGRESS_PCT=0.45
INTRADAY_PROFIT_BOOKING_MIN_PNL_INR=250
INTRADAY_PROFIT_BOOKING_MIN_PNL_PCT=0.003
INTRADAY_SHADOW_EXIT_ENABLED=true
INTRADAY_REENTRY_COOLDOWN_MINUTES=20
INTRADAY_LOSS_DISCIPLINE_ENABLED=true
INTRADAY_LOSS_DISCIPLINE_LOOKBACK_MINUTES=120
INTRADAY_SYMBOL_LOSS_PAUSE_MIN_SAMPLES=4
INTRADAY_SYMBOL_LOSS_PAUSE_LOSS_RATE=0.60
INTRADAY_SYMBOL_LOSS_PAUSE_INR=1000
INTRADAY_SYMBOL_LOSS_PAUSE_PCT=0.01
INTRADAY_MARKET_LOSS_PAUSE_MIN_SAMPLES=20
INTRADAY_MARKET_LOSS_PAUSE_WIN_RATE=0.35
INTRADAY_MARKET_LOSS_PAUSE_INR=5000
SHADOW_INDIA_SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,SBIN,LT,AXISBANK,KOTAKBANK,BAJFINANCE,BHARTIARTL,ITC,HINDUNILVR,SUNPHARMA,MARUTI,TITAN,ASIANPAINT,ULTRACEMCO,POWERGRID,NTPC
SHADOW_US_SYMBOLS=SPY,QQQ,DIA,IWM,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,AMD,AVGO,JPM,V,UNH
